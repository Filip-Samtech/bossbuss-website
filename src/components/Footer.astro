    <p>Tillsammans hela vägen.</p>
    <nav aria-label="Sidfotsmeny">{navigation.map(item => <a href={item.href}>{item.label}</a>)}</nav>
  </div>
  <div class="container footer-bottom"><span>© {new Date().getFullYear()} Bossbuss</span><span>Bussresor med omtanke.</span><a href="#top">Till toppen ↑</a></div>
</footer>
