---
interface Props { label: string; title: string; description?: string; }
const { label, title, description } = Astro.props;
---
<section class="container page-heading">
  <div class="breadcrumb"><a href="/">Start</a><span aria-hidden="true">/</span>{label}</div>
  <p class="eyebrow"><span class="short-line"></span>{label}</p>
  <h1>{title}</h1>
  {description && <p class="lead">{description}</p>}
</section>
