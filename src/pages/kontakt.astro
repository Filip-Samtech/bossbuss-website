---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/PageHeading.astro';
import Arrow from '../components/Arrow.astro';
import { company } from '../data';
---
<Layout title="Kontakt" description="Kontakta Suad Sarajlija på Bossbuss: +46 76 881 91 20 eller info@bossbuss.com. Besök oss på Tallbacksgatan 11G i Rosersberg.">
  <PageHeading label="Kontakt" title="Vi hörs. Och ses på vägen." description="En fråga, en idé eller en resa att planera? Ring, mejla eller skicka en förfrågan så hjälper vi er vidare." />
  <section class="container contact-page-grid" aria-label="Kontaktuppgifter">
    <div class="person-card"><p class="eyebrow">Din kontakt på Bossbuss</p><h2>{company.contact}</h2><p class="role">{company.role}</p><a href={`tel:${company.phoneHref}`}>{company.phone}</a><a href={`mailto:${company.email}`}>{company.email}</a><a class="text-link" href="#forfragan">Skriv till oss<Arrow /></a></div>
    <div class="contact-addresses">
      <div><h2>Besöksadress</h2><address>{company.street}<br />{company.city}, Sverige</address><a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Tallbacksgatan%2011G%2C%20195%2072%20Rosersberg" target="_blank" rel="noopener noreferrer" aria-label="Hitta hit på Google Maps, öppnas i ny flik">Hitta hit<Arrow diagonal /></a></div>
    </div>
  </section>
</Layout>
