---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; description?: string; noindex?: boolean; }
const { title, description = 'Bossbuss erbjuder bussresor för grupper, föreningar och företag. Skidresor, sightseeing och beställningstrafik med personlig service.', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#a6ce38" />
    <title>{title} | Bossbuss</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:title" content={`${title} | Bossbuss`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Hoppa till innehållet</a>
    <Header />
    <main id="main"><slot /><Contact /></main>
    <Footer />
  </body>
</html>
